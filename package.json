    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "preandroid": "npm run adb:reverse",
    "android": "expo run:android",
    "adb:reverse": "powershell -ExecutionPolicy Bypass -File ./scripts/adb-reverse-ports.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand",
    "update:preview": "eas update --branch preview",
    "update:preview:upload": "eas update --branch preview --skip-bundler",
    "update:preview:ios": "eas update --branch preview -p ios",
    "update:preview:android": "eas update --branch preview -p android",
    "env:push:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/push-eas-preview-env.ps1",
    "env:push:production": "powershell -ExecutionPolicy Bypass -File ./scripts/push-eas-preview-env.ps1 -Environment production"
