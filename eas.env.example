# Copy to EAS Environment Variables (preview + production).
# Local .env is NOT uploaded to EAS (gitignored).
#
# Setup:
#   1. Fill every EXPO_PUBLIC_* URL below (use your server IP, tunnel, or production domain).
#   2. Deploy latest code for team-service, event-service, schedule-service on those hosts.
#   3. Push to EAS (do NOT use eas env:push --force — it fails on SENTRY_AUTH_TOKEN):
#        npm run env:push:preview
#     Or: .\scripts\push-eas-preview-env.ps1
#      Or add each variable in Expo dashboard → Project → Environment variables.
#   4. Rebuild:
#        eas build --platform android --profile preview
#
# All services must be reachable from the phone (not localhost on your PC).

EXPO_PUBLIC_AUTH_API_URL=https://YOUR_HOST/api/v1/auth
EXPO_PUBLIC_PROFILE_API_URL=https://YOUR_HOST/api/v1/profile
EXPO_PUBLIC_POST_API_URL=https://YOUR_HOST/api/v1/post
# Community feed (post-service) — required for Posts in preview/APK builds
EXPO_PUBLIC_COMMUNITY_POST_API_URL=https://YOUR_HOST/api/v1/posts
EXPO_PUBLIC_CHATBOT_API_URL=https://YOUR_HOST/api/v1/chatbot

EXPO_PUBLIC_TEAM_API_URL=https://YOUR_HOST/api/v1/team
EXPO_PUBLIC_PLAYER_API_URL=https://YOUR_HOST/api/v1/players
EXPO_PUBLIC_MESSAGE_API_URL=https://YOUR_HOST/api/v1/messages
EXPO_PUBLIC_AVAILABILITY_API_URL=https://YOUR_HOST/api/v1/availability
EXPO_PUBLIC_ASSIGNMENT_API_URL=https://YOUR_HOST/api/v1/assignments

EXPO_PUBLIC_SCHEDULE_API_URL=https://YOUR_HOST/api/v1/schedule
EXPO_PUBLIC_EVENT_API_URL=https://YOUR_HOST/api/v1/events
EXPO_PUBLIC_GAME_API_URL=https://YOUR_HOST/api/v1/game
EXPO_PUBLIC_GAME_WS_URL=https://YOUR_HOST
EXPO_PUBLIC_PLAYER_WS_URL=https://YOUR_HOST

EXPO_PUBLIC_TRICOUNT_API_URL=https://YOUR_HOST/api/v1/tricount
EXPO_PUBLIC_LIVE_STREAM_API_URL=https://YOUR_HOST
EXPO_PUBLIC_SUPPORT_API_URL=https://YOUR_HOST/api/v1/support
EXPO_PUBLIC_SUPPORT_WS_URL=https://YOUR_HOST

EXPO_PUBLIC_APP_LINK_BASE_URL=https://YOUR_HOST
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_key
# Web + Android + iOS OAuth clients (same GCP project as auth-service GOOGLE_*)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=937573920313-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=937573920313-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=937573920313-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GIPHY_API_KEY=your_giphy_key
EXPO_PUBLIC_PROJECT_ID=your_expo_project_id
