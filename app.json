{
  "expo": {
    "name": "PlayFlash",
    "slug": "playflash",
    "owner": "eagleiitech",
    "version": "1.0.2",
    "runtimeVersion": "1.0.2",
    "orientation": "default",
    "icon": "./assets/logos/app_logo.png",
    "scheme": "playflash",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logos/app_logo.png",
        "monochromeImage": "./assets/logos/app_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.eagleiitech.playflash",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "playflash.app",
              "pathPrefix": "/tricount"
            },
            {
              "scheme": "https",
              "host": "playflash.app",
              "pathPrefix": "/join/tricount"
            },
            {
              "scheme": "https",
              "host": "playflash.app",
              "pathPrefix": "/join/events"
            },
            {
              "scheme": "https",
              "host": "playflash.app",
              "pathPrefix": "/events"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "playflash"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eagleiitech.playflash",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "PlayFlash needs camera access to scan QR codes and take photos.",
        "NSPhotoLibraryUsageDescription": "PlayFlash needs access to your photos to add player images.",
        "NSLocationWhenInUseUsageDescription": "PlayFlash uses your location to show nearby events.",
        "NSMicrophoneUsageDescription": "PlayFlash needs microphone access for live streaming."
      },
      "associatedDomains": [
        "applinks:playflash.app"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-updates",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/applogo-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "jsm-mastery-bo"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B7FF57",
          "defaultChannel": "assignments"
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlayFlash needs access to your photos to add player images.",
          "cameraPermission": "PlayFlash needs camera access to take player photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PlayFlash needs camera access to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlayFlash uses your location to show nearby events."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.937573920313-pi7rjhr9meqpnr2ehi14jdj4ksamgeh3"
        }
      ],
      "./plugins/withIosModularHeaders"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1ab9669-91cb-49b7-a4b3-6cec2f161dc0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e1ab9669-91cb-49b7-a4b3-6cec2f161dc0"
    }
  }
}
